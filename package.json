{
  "name": "ai-receptionist-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready, multi-tenant AI Voice Receptionist SaaS platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
