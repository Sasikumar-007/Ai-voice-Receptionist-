# ====================================================================
# AI Voice Receptionist SaaS — Environment Variables
# ====================================================================

# Environment & Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
JWT_SECRET=super-secret-jwt-token-replace-in-production-min32chars

# Supabase (PostgreSQL Database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Google Gemini AI API (Required for reasoning & tool calling)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Twilio Voice Integration (Inbound Call Handling & TwiML)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15550192831

# Google Calendar (OAuth 2.0 Integration)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-yourGoogleClientSecret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback

# Resend (Email Notifications for Leads and Appointments)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_FROM_EMAIL=receptionist@yourdomain.com

# WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_ACCESS_TOKEN=EAAG...yourWhatsAppSystemUserToken
WHATSAPP_PHONE_NUMBER_ID=109283746592837
WHATSAPP_VERIFY_TOKEN=your_secure_random_webhook_verification_token
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321012345

# Mock / Offline Mode
# Set to 'true' to use in-memory seed database with full interactive voice simulation
ENABLE_MOCK_FALLBACK=true
